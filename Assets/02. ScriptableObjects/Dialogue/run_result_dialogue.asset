  m_Script: {fileID: 11500000, guid: b38001e1fc763af4ea70a4690bc2d65d, type: 3}
  m_Name: run_result_dialogue
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.RunResultDialogueSO
  charactersPerSecond: 40
  victoryLines:
  - "\uB2F9\uC2E0\uC774 \uCD5C\uC885 \uC2B9\uB9AC\uD558\uC168\uAD70\uC694. \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4."
  - "\uC774\uC81C \uB2F9\uC2E0\uC758 \uC790\uB9AC\uB85C \uB3CC\uC544\uAC00\uC2ED\uC2DC\uC624."
  contractedVictoryLines:
  - "\uADF8\uB7F0\uB370.."
  - "\uC545\uB9C8\uC758 \uD798\uC744 \uC0AC\uC6A9\uD558\uC168\uAD70\uC694?"
  - "\uAC15\uB825\uD55C \uD798\uC744 \uC0AC\uC6A9\uD558\uC168\uB2E4\uBA74,\n\uB300\uAC00\uB97C
    \uCE58\uB904\uC57C\uACA0\uC9C0\uC694."
  - "\uC5B8\uC81C\uAC00 \uB420\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC\uC694."
  - "\uC601\uC6D0\uD788 \uC545\uB9C8\uC640 \uD568\uAED8 \uD558\uB294 \uC0B6\uC744
    \uBCF4\uB0B4\uC2DC\uAE38."
  defeatOpeningLines:
  - "\uAD1C\uCC2E\uC544\uC694. \uB2F9\uC2E0\uC740 \uD754\uD558\uB514 \uD754\uD55C\n\uD328\uBC30\uC790
    \uC911 \uD55C \uBA85\uC77C \uBFD0\uC785\uB2C8\uB2E4."
  opponentDefeatLines:
  - profileKey: cowardly-gambler
    lines:
    - "\uAC81\uC7C1\uC774 \uB3C4\uBC15\uC0AC\uC5D0\uAC8C \uC9C4 \uAC74 ...\n\uC870\uAE08
      \uBD80\uB044\uB7EC\uC6CC \uD560 \uD544\uC694\uAC00 \uC788\uACA0\uAD70\uC694."
  - profileKey: gunslinger
    lines:
    - "\uCD1D\uC7A1\uC774\uC758 \uCD1D\uC54C\uC5D0 \uBA38\uB9AC\uAC00 \uAFF0\uB6AB\uB9AC\uC168\uAD70\uC694."
  - profileKey: cultist
    lines:
    - "\uC545\uB9C8\uC758 \uD798\uC744 \uC0AC\uC6A9\uD558\uB294 \uAD11\uC2E0\uB3C4\uB294\n\uC544\uBB34\uB798\uB3C4
      \uD798\uB4E0 \uC0C1\uB300\uC8E0."
  - profileKey: trickster
    lines:
    - "\uC0AC\uAE30\uAFBC\uC758 \uAD50\uBB18\uD55C \uC190\uB180\uB9BC\uC744\n\uAFF0\uB6AB\uC5B4\uBCF4\uC9C0
      \uBABB\uD558\uC168\uAD70\uC694."
  - profileKey: enforcer
    lines:
    - "\uC9D1\uD589\uC790\uC758 \uC9D1\uD589\uC744 \uD53C\uD574\uAC04 \uC0AC\uB78C\uC740
      \uC5C6\uC5C8\uC8E0."
  - profileKey: final-boss
    lines:
    - "\uAC10\uD788 \uBCF4\uC2A4\uC5D0\uAC8C \uB3C4\uC804\uD558\uB2E4\uB2C8,\n\uADF8
      \uC6A9\uAE30\uB9CC\uC740 \uAE30\uC5B5\uB420 \uAC83\uC785\uB2C8\uB2E4. "
  defeatClosingLines:
  - "\uC774\uC81C \uB2F9\uC2E0\uC740 \uACE0\uD1B5\uBC1B\uC744 \uAC81\uB2C8\uB2E4.
    \uC601\uC6D0\uD788\uC694."
  - "\uBD88\uD589\uD55C \uC2DC\uAC04 \uBCF4\uB0B4\uC2DC\uAE38."
