  m_Name: azazel
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.DemonCardDefinitionSO
  key: azazel
  displayName: "\uC544\uC790\uC824"
  activeEffectDescription: "\uACC4\uC57D \uC9C1\uD6C4, \uC790\uC2E0\uC758 \uACF5\uAC1C
    \uCE74\uB4DC \uD6A8\uACFC\uB97C \uC67C\uCABD\uBD80\uD130 \uC624\uB978\uCABD \uC21C\uC11C\uB85C
    \uAC01\uAC01 \uD55C \uBC88\uC529 <b>\uBC1C\uB3D9\uD569\uB2C8\uB2E4.</b>\n<b>\uD788\uD2B8\uD560
    \uB54C\uB9C8\uB2E4 \uC704 \uD6A8\uACFC\uB97C \uBC18\uBCF5\uD569\uB2C8\uB2E4.</b>"
  costDescription: "<b>\uAC19\uC740 \uC22B\uC790\uC758 \uACF5\uAC1C \uCE74\uB4DC</b>\uAC00
    \uCD94\uAC00\uB418\uBA74 <b>\uBC84\uC2A4\uD2B8</b>\uD569\uB2C8\uB2E4."
  codexLoreDescription: "\uC544\uC790\uC824\uC740 \uC791\uACE0 \uC0AC\uB791\uC2A4\uB7EC\uC6B4
    \uC5BC\uAD74\uACFC \uBE5B\uBC14\uB79C \uB0A0\uAC1C\uB97C \uC9C0\uB2CC \uCC44
    \uC778\uAC04 \uC55E\uC5D0 \uB0B4\uB824\uC624\uB294 \uD0C0\uCC9C\uC0AC\uB2E4.\n\uADF8\uB140\uB294
    \uC21C\uC9C4\uD55C \uBBF8\uC18C\uC640 \uD568\uAED8 \uC7A0\uB4E4\uC5B4 \uC788\uB358
    \uBB34\uAE30\uC640 \uB3C4\uAD6C\uB97C \uAE68\uC6B0\uB294 \uAC15\uB825\uD55C \uD798\uC744
    \uC120\uBB3C\uD55C\uB2E4.\n\uADF8\uB140\uB97C \uB530\uB974\uB294 \uC790\uB294
    \uC787\uB530\uB77C \uBC8C\uC5B4\uC9C0\uB294 \uAE30\uC801\uC5D0 \uB9E4\uD639\uB418\uC5B4
    \uADF8 \uD798\uC744 \uC790\uC2E0\uC758 \uC7AC\uB2A5\uC774\uB77C \uBBFF\uB294\uB2E4.\n\uADF8\uB7EC\uB098
    \uAC19\uC740 \uD798\uC744 \uBC18\uBCF5\uD574\uC11C \uD0D0\uD558\uB294 \uC21C\uAC04
    \uCD95\uBCF5\uC740 \uC800\uC8FC\uB85C \uB4A4\uC9D1\uD788\uACE0, \uAE68\uC5B4\uB09C
    \uB3C4\uAD6C\uB4E4\uC740 \uC8FC\uC778\uC5D0\uAC8C \uCE7C\uB0A0\uC744 \uB3CC\uB9B0\uB2E4.\n\uB3C4\uB9DD\uCE60
    \uAE38\uC774 \uC0AC\uB77C\uC9C4 \uB4A4\uC5D0\uB3C4 \uC544\uC790\uC824\uC740 \uCC9C\uC9C4\uD55C
    \uC5BC\uAD74\uB85C \uB2E4\uC74C\uC5D0\uB294 \uB354 \uC798\uD560 \uC218 \uC788\uB2E4\uACE0
    \uC18D\uC0AD\uC778\uB2E4."
