  key: asmodeus
  displayName: "\uC544\uC2A4\uBAA8\uB370\uC6B0\uC2A4"
  activeEffectDescription: "\uCC28\uB840 \uC2DC\uC791 \uC2DC <b>\uC2A4\uD0E0\uB4DC</b>\uD558\uC9C0
    \uC54A\uC740 \uC0C1\uB300\uC5D0\uAC8C <b>\uD788\uD2B8\uB97C \uAC15\uC81C\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.</b>"
  costDescription: "\uC22B\uC790 7 \uC774\uD558 \uCE74\uB4DC\uC758 \uD6A8\uACFC\uB97C
    <b>\uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.</b>"
  codexLoreDescription: "\uC544\uC2A4\uBAA8\uB370\uC6B0\uC2A4\uB294 \uC0C1\uB300\uAC00
    \uAC00\uC7A5 \uAC08\uB9DD\uD558\uB294 \uBAA8\uC2B5\uC73C\uB85C \uB098\uD0C0\uB098
    \uAE4A\uC774 \uAC10\uCD98 \uC695\uB9DD\uC744 \uAE68\uC6B0\uB294 \uC0C9\uC695\uC758
    \uC545\uB9C8\uB2E4.\n\uADF8\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC740 \uC790\uB294
    \uC790\uC2E0\uC758 \uC758\uC9C0\uB77C \uBBFF\uC73C\uBA70 \uCF8C\uB77D\uACFC \uD798\uC744
    \uD5A5\uD574 \uD55C \uAC78\uC74C\uC529 \uB354 \uB098\uC544\uAC04\uB2E4.\n\uC695\uB9DD\uC744
    \uB530\uB97C\uC218\uB85D \uC791\uC740 \uB9CC\uC871\uC740 \uBE5B\uC744 \uC783\uACE0,
    \uC774\uC804\uBCF4\uB2E4 \uAC15\uD55C \uC790\uADF9 \uC5C6\uC774\uB294 \uC544\uBB34\uAC83\uB3C4
    \uB290\uB084 \uC218 \uC5C6\uAC8C \uB41C\uB2E4.\n\uACC4\uC57D\uC790\uB294 \uB05D\uC5C6\uB294
    \uAC08\uC99D\uC744 \uCC44\uC6B0\uAE30 \uC704\uD574 \uCE5C\uAD6C\uC640 \uBA85\uC608,
    \uB9C8\uC9C0\uB9C9\uC5D0\uB294 \uC790\uC2E0\uC758 \uC601\uD63C\uAE4C\uC9C0 \uB0B4\uC5B4\uB193\uB294\uB2E4.\n\uB3CC\uC774\uD0AC
    \uC218 \uC5C6\uB294 \uACF3\uC5D0 \uB3C4\uCC29\uD558\uBA74 \uC544\uC2A4\uBAA8\uB370\uC6B0\uC2A4\uB294
    \uC544\uC9C1 \uD55C \uAC78\uC74C\uC774 \uB354 \uB0A8\uC558\uB2E4\uACE0 \uC18D\uC0AD\uC778\uB2E4."
