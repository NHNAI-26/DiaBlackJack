  key: mammon
  displayName: "\uB9C8\uBAAC"
  activeEffectDescription: "\uACC4\uC57D \uC9C1\uD6C4 <color=#3B82F6>\uC8FC\uC0AC\uC704</color>\uB97C
    \uAD74\uB9BD\uB2C8\uB2E4.\n\uC790\uC2E0\uC758 \uCC28\uB840\uC5D0 \uC77C\uBC18
    \uD589\uB3D9 \uB300\uC2E0, <color=#3B82F6>\uC8FC\uC0AC\uC704</color>\uB97C \uB2E4\uC2DC
    \uAD74\uB9AC\uACE0 \uCC28\uB840\uB97C \uB05D\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC2B9\uBD80
    \uC804\uC5D0 <b><color=#3B82F6>\uC8FC\uC0AC\uC704</color> \uAC12\uC744 \uCE74\uB4DC
    \uD569\uC5D0 \uB354\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</b>\n\uC0C8 \uB77C\uC6B4\uB4DC
    \uC2DC\uC791 \uC2DC, <color=#3B82F6>\uC8FC\uC0AC\uC704</color>\uB97C \uB2E4\uC2DC
    \uAD74\uB9BD\uB2C8\uB2E4."
  costDescription: "<color=#3B82F6>\uC8FC\uC0AC\uC704</color>\uAC00 <size=150%><sprite=\"MammonSkullIcon\"
    index=0></size>\uC774 \uB098\uC624\uBA74 <b>\uBC84\uC2A4\uD2B8</b>\uD569\uB2C8\uB2E4."
  codexLoreDescription: "\uB9C8\uBAAC\uC740 \uC138\uC0C1\uC758 \uBAA8\uB4E0 \uD589\uC6B4\uACFC
    \uAC00\uB2A5\uC131\uC5D0 \uAC12\uC744 \uB9E4\uAE30\uB294 \uD0D0\uC695\uC758 \uC545\uB9C8\uB2E4.\n\uADF8\uB294
    \uC6B4\uBA85\uC744 \uBC14\uAFB8\uB294 \uC8FC\uC0AC\uC704\uB97C \uAC74\uB124\uBA70
    \uB2E8 \uD55C \uBC88\uB9CC \uB354 \uAD74\uB9AC\uBA74 \uB354 \uD070 \uAC83\uC744
    \uC5BB\uB294\uB2E4\uACE0 \uC720\uD639\uD55C\uB2E4.\n\uC2B9\uB9AC\uAC00 \uBC18\uBCF5\uB420\uC218\uB85D
    \uACC4\uC57D\uC790\uB294 \uB9CC\uC871\uC744 \uC78A\uACE0 \uAC00\uC9C4 \uBAA8\uB4E0
    \uAC83\uACFC \uBAA9\uC228\uAE4C\uC9C0 \uB9C8\uC9C0\uB9C9 \uD310\uB3C8\uC73C\uB85C
    \uC62C\uB824\uB193\uB294\uB2E4.\n\uC8FC\uC0AC\uC704\uC5D0 \uD574\uACE8\uC774
    \uB098\uD0C0\uB09C \uC21C\uAC04\uC5D0\uC57C \uADF8\uB294 \uBD80\uB97C \uC313\uC740
    \uAC83\uC774 \uC544\uB2C8\uB77C \uB9C8\uBAAC\uC758 \uC7AC\uC0B0\uC774 \uB418\uC5B4
    \uC654\uC74C\uC744 \uAE68\uB2EB\uB294\uB2E4.\n\uB9C8\uBAAC\uC740 \uC4F0\uB7EC\uC9C4
    \uACC4\uC57D\uC790\uC758 \uC190\uC5D0\uC11C \uC8FC\uC0AC\uC704\uB97C \uAC70\uB450\uACE0
    \uB2E4\uC74C \uC695\uC2EC \uB9CE\uC740 \uC8FC\uC778\uC744 \uCC3E\uC544 \uB098\uC120\uB2E4."
