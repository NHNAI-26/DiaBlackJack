  displayName: "\uBC14\uC54C\uC81C\uBD91"
  activeEffectDescription: "\uBC84\uC2A4\uD2B8\uD560 \uB54C \uC601\uD63C 1\uC744
    \uC9C0\uBD88\uD558\uACE0, \uC591\uCE21 \uACF5\uAC1C \uCE74\uB4DC 1\uC7A5\uC529\uC744
    \uACE8\uB77C \uBC84\uB9B0 \uB4A4 \uC0DD\uC874\uD569\uB2C8\uB2E4."
  costDescription: "\uC790\uC2E0\uC758 \uACF5\uAC1C \uCE74\uB4DC\uAC00 3\uC7A5 \uC774\uD558\uB77C\uBA74
    \uC2A4\uD0E0\uB4DC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  codexLoreDescription: "\uBC14\uC54C\uC81C\uBD91\uC740 \uC369\uC5B4 \uAC00\uB294
    \uC804\uC7A5\uACFC \uC8FD\uC9C0 \uBABB\uD55C \uC790\uB4E4\uC758 \uBE44\uBA85
    \uC704\uC5D0 \uAD70\uB9BC\uD558\uB294 \uD30C\uB9AC\uC758 \uAD70\uC8FC\uB2E4.\n\uADF8\uB294
    \uC8FD\uC74C\uC5D0 \uC774\uB978 \uACC4\uC57D\uC790\uC758 \uC601\uD63C\uC744 \uB300\uAC00\uB85C
    \uC721\uCCB4\uB97C \uB2E4\uC2DC \uC77C\uC73C\uCF1C \uC138\uC6B4\uB2E4.\n\uBA87
    \uBC88\uC774\uACE0 \uC0B4\uC544\uB0A8\uC740 \uACC4\uC57D\uC790\uB294 \uC790\uC2E0\uC774
    \uC8FD\uC74C\uC744 \uC815\uBCF5\uD588\uB2E4\uACE0 \uBBFF\uC73C\uBA70 \uBD88\uBA78\uC758
    \uD798\uC5D0 \uCDE8\uD55C\uB2E4.\n\uADF8\uB7EC\uB098 \uB418\uC0B4\uC544\uB0A0
    \uB54C\uB9C8\uB2E4 \uAC80\uC740 \uD30C\uB9AC \uB5BC\uB294 \uC601\uD63C\uACFC
    \uAE30\uC5B5\uC744 \uC870\uAE08\uC529 \uB72F\uC5B4 \uBA39\uACE0 \uC369\uC740
    \uC721\uCCB4\uB9CC \uB0A8\uAE34\uB2E4.\n\uBC14\uC54C\uC81C\uBD91\uC774 \uC57D\uC18D\uD55C
    \uBD88\uBA78\uC774\uB780 \uACC4\uC57D\uC790\uAC00 \uC601\uC6D0\uD788 \uADF8\uC758
    \uC2DD\uC0AC\uB85C \uB0A8\uB294\uB2E4\uB294 \uB73B\uC774\uB2E4."
