  key: belphegor
  displayName: "\uBCA8\uD398\uACE0\uB974"
  activeEffectDescription: "<b>\uD788\uD2B8</b> \uC804\uC5D0 \uB371 \uC704 \uCE74\uB4DC\uB97C
    \uD655\uC778\uD569\uB2C8\uB2E4.\n\uADF8 \uCE74\uB4DC\uB97C \uADF8\uB300\uB85C
    \uBF51\uAC70\uB098 \uB371 \uC544\uB798\uB85C \uBCF4\uB0B4\uACE0 \uCC28\uB840\uB97C
    \uB05D\uB0C5\uB2C8\uB2E4."
  costDescription: "\uC0C1\uB300\uAC00 <b>\uC2A4\uD0E0\uB4DC</b>\uD558\uBA74 \uB2E4\uC74C
    \uC790\uC2E0\uC758 \uCC28\uB840 \uC885\uB8CC \uC2DC <b>\uAC15\uC81C\uB85C \uC2A4\uD0E0\uB4DC\uD569\uB2C8\uB2E4.</b>"
  codexLoreDescription: "\uBCA8\uD398\uACE0\uB974\uB294 \uB0A1\uC740 \uB098\uBB34
    \uC758\uC790\uC5D0 \uBAB8\uC744 \uBB3B\uC740 \uCC44 \uC544\uC9C1 \uC624\uC9C0
    \uC54A\uC740 \uBBF8\uB798\uB97C \uB0B4\uB824\uB2E4\uBCF4\uB294 \uB098\uD0DC\uC758
    \uC545\uB9C8\uB2E4.\n\uADF8\uB294 \uACC4\uC57D\uC790\uC5D0\uAC8C \uB2E4\uAC00\uC62C
    \uC704\uD5D8\uC744 \uBCF4\uC5EC \uC8FC\uACE0, \uAC00\uC7A5 \uD3B8\uC548\uD558\uAC8C
    \uD53C\uD560 \uC218 \uC788\uB294 \uAE38\uC744 \uC18D\uC0AD\uC778\uB2E4.\n\uADF8\uC758
    \uC870\uC5B8\uC744 \uB530\uB97C\uC218\uB85D \uC2E4\uD328\uB294 \uC904\uC5B4\uB4E4\uC9C0\uB9CC,
    \uC2A4\uC2A4\uB85C \uC120\uD0DD\uD558\uACE0 \uC6C0\uC9C1\uC5EC\uC57C \uD560 \uC774\uC720\uB3C4
    \uD568\uAED8 \uC0AC\uB77C\uC9C4\uB2E4.\n\uACC4\uC57D\uC790\uAC00 \uC758\uC790
    \uACC1\uC5D0\uC11C \uC26C\uB294 \uB3D9\uC548 \uC218\uB9CE\uC740 \uAE30\uD68C\uC640
    \uC778\uC5F0\uC740 \uC9C0\uB098\uAC00\uACE0 \uBAB8\uC740 \uC11C\uC11C\uD788 \uAD73\uC5B4
    \uAC04\uB2E4.\n\uBAA8\uB4E0 \uAC83\uC744 \uD758\uB824\uBCF4\uB0C8\uB2E4\uB294
    \uC0AC\uC2E4\uC744 \uAE68\uB2EC\uC558\uC744 \uB54C, \uBCA8\uD398\uACE0\uB974\uB294
    \uB290\uAE0B\uD558\uAC8C \uB2E4\uC74C \uBBF8\uB798\uB97C \uBCF4\uC5EC \uC900\uB2E4."
