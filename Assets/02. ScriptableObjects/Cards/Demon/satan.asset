  m_Script: {fileID: 11500000, guid: d658a77d998e43f1b3fa1f8d0a110002, type: 3}
  m_Name: satan
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.DemonCardDefinitionSO
  key: satan
  displayName: "\uC0AC\uD0C4"
  activeEffectDescription: "\uC2A4\uD0E0\uB4DC\uD560 \uC218 \uC5C6\uC73C\uBA70 \uC5B4\uB5A4
    \uC774\uC720\uB85C\uB3C4 \uBC84\uC2A4\uD2B8\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uC790\uC2E0\uC758
    \uCC28\uB840\uC5D0 \uC77C\uBC18 \uD589\uB3D9 \uB300\uC2E0, \uC0AC\uD0C4\uC758
    \uB2A5\uB825\uC744 \uC0AC\uC6A9\uD558\uACE0 \uCC28\uB840\uB97C \uB05D\uB0BC \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n\uC0AC\uD0C4\uC758 \uB2A5\uB825\uC740 \uC0AC\uD0C4\uC774
    \uD5A5\uD558\uB294 \uBC29\uD5A5\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9C0\uBA70,
    \uB2A5\uB825\uC744 \uC4F8 \uB54C\uB9C8\uB2E4 \uBC29\uD5A5\uC744 \uBC14\uAFC9\uB2C8\uB2E4.\n\n\uC815\uBC29\uD5A5:
    \uC22B\uC790 2\uAC1C\uB97C \uC120\uC5B8\uD569\uB2C8\uB2E4. \uB458 \uC911 \uD558\uB098\uB77C\uB3C4
    \uC0C1\uB300 \uBE44\uACF5\uAC1C \uCE74\uB4DC\uC640 \uC77C\uCE58\uD558\uBA74 \uC0C1\uB300\uB97C
    \uBC84\uC2A4\uD2B8\uC2DC\uD0B5\uB2C8\uB2E4.\n\uC5ED\uBC29\uD5A5: \uC0C1\uB300\uC5D0\uAC8C
    \uD788\uD2B8\uB97C \uAC15\uC81C\uD569\uB2C8\uB2E4. \uBC84\uC2A4\uD2B8\uD558\uC9C0
    \uC54A\uC73C\uBA74 \uBF51\uC740 \uCE74\uB4DC\uB97C \uBC84\uB9BD\uB2C8\uB2E4."
  costDescription: "\uACC4\uC57D \uC9C1\uD6C4 \uC885\uB9D0 \uCE74\uC6B4\uD2B8\uB97C
    4 \uC5BB\uC2B5\uB2C8\uB2E4. \uC790\uC2E0\uC758 \uCC28\uB840\uB97C \uC2DC\uC791\uD560
    \uB54C\uB9C8\uB2E4 \uC885\uB9D0 \uCE74\uC6B4\uD2B8\uAC00 1 \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\uC790\uC2E0\uC758
    \uCC28\uB840\uB97C \uC2DC\uC791\uD560 \uB54C\uB9C8\uB2E4 \uC885\uB9D0 \uCE74\uC6B4\uD2B8\uAC00
    0 \uC774\uD558\uB77C\uBA74, \uC601\uD63C 2\uB97C \uC783\uC2B5\uB2C8\uB2E4."
  codexLoreDescription: "\uC0AC\uD0C4\uC740 \uD328\uBC30\uC640 \uC8FD\uC74C\uB9C8\uC800
    \uC790\uC2E0\uC758 \uD5C8\uB77D \uC5C6\uC774\uB294 \uCC3E\uC544\uC62C \uC218
    \uC5C6\uB2E4\uACE0 \uBBFF\uB294 \uC9C0\uC625\uC758 \uC655\uC774\uB2E4.\n\uADF8\uB294
    \uB05D\uB098\uC57C \uD560 \uC2B9\uBD80\uB97C \uC5B5\uC9C0\uB85C \uC774\uC5B4
    \uBD99\uC774\uACE0, \uACC4\uC57D\uC790\uC5D0\uAC8C \uC5B4\uB5A4 \uC704\uAE30\uC5D0\uC11C\uB3C4
    \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uB294 \uD798\uC744 \uB0B4\uB9B0\uB2E4.\n\uADF8
    \uD798\uC5D0 \uCDE8\uD55C \uC790\uB294 \uBD80\uC11C\uC9C4 \uC721\uCCB4\uB85C\uB3C4
    \uC77C\uC5B4\uC11C\uBA70 \uD758\uB7EC\uB098\uAC04 \uD53C\uC640 \uC601\uD63C\uC870\uCC28
    \uC2B9\uB9AC\uC758 \uB300\uAC00\uB85C \uC5EC\uAE34\uB2E4.\n\uC885\uB9D0\uC774
    \uAC00\uAE4C\uC6CC\uC9C8\uC218\uB85D \uBAB8\uC740 \uBB38\uB4DC\uB7EC\uC9C0\uACE0
    \uC601\uD63C\uC740 \uBE60\uC838\uB098\uAC00\uC9C0\uB9CC, \uACC4\uC57D\uC790\uB294
    \uC790\uC2E0\uC758 \uD30C\uBA78\uC744 \uAE68\uB2EB\uC9C0 \uBABB\uD55C\uB2E4.\n\uC0AC\uD0C4\uC740
    \uB9C8\uCE68\uB0B4 \uD145 \uBE48 \uC721\uCCB4\uAC00 \uC4F0\uB7EC\uC9C0\uB294
    \uBAA8\uC2B5\uC744 \uB0B4\uB824\uB2E4\uBCF4\uBA70 \uB2E4\uC74C \uC2B9\uBD80\uB97C
    \uAE30\uB2E4\uB9B0\uB2E4."
  baseSoulCost: 1
