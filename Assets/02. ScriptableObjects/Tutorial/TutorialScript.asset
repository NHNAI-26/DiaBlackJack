  m_Script: {fileID: 11500000, guid: a8863437218bfc241a1f0eda9c231b0a, type: 3}
  m_Name: TutorialScript
  m_EditorClassIdentifier: Border::DiaBlackJack.GameScene.TutorialScriptSO
  steps:
  - kind: 0
    lines:
    - "\uB4DC\uB514\uC5B4 \uC815\uC2E0\uC744 \uCC28\uB838\uAD70."
    - "\uB10C \uC9C0\uAE08\uBD80\uD130 \uC544\uC8FC \uAC04\uB2E8\uD55C \uAC8C\uC784\uC744\n\uD558\uAC8C
      \uB420 \uAC70\uC57C. **\uBE14\uB799\uC7AD.**"
    - "\uADF8\uB7F0\uB370 \u2026 \uADF8\uB0E5 \uD558\uBA74 \uC7AC\uBBF8 \uC5C6\uC796\uC544?
      \uBB50 \uD558\uB098 \uAC78\uACE0 \uD558\uB294 \uD3B8\uC774 \uC2A4\uB9B4 \uC788\uC9C0
      \uC54A\uACA0\uC5B4?"
    - "\uB3C8? \uADF8\uB7F0 \uAC74 \uB530\uBD84\uD558\uC9C0."
    - "**\uB124 \uBAA9\uC228.** \uADF8\uB798, \uADF8\uAC8C \uC88B\uACA0\uB124."
    - "\uC2B9\uBD80\uC5D0\uC11C \uD328\uBC30\uD558\uBA74, \uD328\uC790\uB294 **(\uBE68\uAC15)\uC8FD\uB294\uB2E4.**"
    - "\uC0B4\uAE30 \uC704\uD574\uC11C \uC5B4\uB5A4 \uBC29\uBC95\uC774\uB4E0 \uC368\uBCF4\uB77C\uACE0.\n\uCD1D\uC774\uB4E0,
      \uCE7C\uC774\uB4E0, \uC544\uB2C8\uBA74 \uC545\uB9C8\uC758 \uD798\uC774\uB4E0
      \u2026"
    isIntro: 1
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey:
    contractOptionId: 0
  - kind: 0
    lines:
    - "\uBE14\uB799\uC7AD\uC740 \uC790\uC2E0\uC758 \uCE74\uB4DC \uC22B\uC790 \uD569\uC744\n21\uC5D0
      \uAC00\uAE5D\uAC8C \uB9CC\uB4DC\uB294 \uAC8C\uC784\uC774\uC57C."
    - "\uD558\uC9C0\uB9CC \uC808\uB300 21\uC744 \uB118\uACA8\uC11C\uB294 \uC548 \uB418\uC9C0."
    - "21\uC744 \uB118\uAE30\uC9C0 \uC54A\uC73C\uBA74\uC11C, \uC0C1\uB300\uBCF4\uB2E4\n21\uC5D0
      \uAC00\uAE5D\uAC8C \uB9DE\uCD98 \uC0AC\uB78C\uC774 \uADF8 \uD310\uC744 \uAC00\uC838\uAC04\uB2E4."
    - "\uAC04\uB2E8\uD558\uC9C0? \uD55C \uBC88 \uD574\uBCF4\uC790\uACE0."
    - "\uB77C\uC6B4\uB4DC\uAC00 \uC2DC\uC791\uB418\uBA74 **\uBE44\uACF5\uAC1C \uCE74\uB4DC**\uC640\n**\uACF5\uAC1C
      \uCE74\uB4DC**\uB97C 1\uC7A5\uC529 \uBC1B\uC544."
    - "**\uBE44\uACF5\uAC1C \uCE74\uB4DC**\uB294 \uC790\uC2E0\uB9CC \uC54C \uC218
      \uC788\uC9C0\uB9CC,\n**\uACF5\uAC1C \uCE74\uB4DC**\uB294 \uB204\uAD6C\uB4E0\uC9C0
      \uC54C \uC218 \uC788\uC9C0."
    - "**\uBE44\uACF5\uAC1C \uCE74\uB4DC**\uB294 \uB4B7\uBA74\uC5D0 \uCEE4\uC11C\uB97C
      \uC62C\uB9AC\uBA74\n\uBC14\uB85C \uC54C \uC218 \uC788\uC73C\uB2C8 \uD56D\uC0C1
      \uCC38\uACE0\uD558\uB3C4\uB85D."
    - "**(\uD30C\uB791)\uD788\uD2B8** \uBC84\uD2BC\uC744 \uB204\uB974\uBA74, \uC790\uC2E0\uC758
      \uB371\uC5D0\uC11C \n\uCE74\uB4DC \uD55C \uC7A5\uC744 \uBF51\uC544 \uACF5\uAC1C
      \uCE74\uB4DC\uC5D0 \uCD94\uAC00\uD560 \uC218 \uC788\uC5B4. (\uD788\uD2B8 \uBC84\uD2BC
      \uD558\uC774\uB77C\uC774\uD2B8)"
    isIntro: 0
    delayBeforeSeconds: 2
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey:
    contractOptionId: 0
  - kind: 1
    lines: []
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey:
    contractOptionId: 0
  - kind: 0
    lines:
    - "\uB0B4 \uD134\uC5D0 \uD589\uB3D9\uC744 \uD558\uB098 \uC120\uD0DD\uD558\uBA74,\n\uC0C1\uB300\uC5D0\uAC8C
      \uCC28\uB840\uAC00 \uB118\uC5B4\uAC04\uB2E4."
    - "\uC774\uBC88\uC5D4 \uC0C1\uB300\uB3C4 \uD788\uD2B8\uB97C \uD588\uAD70."
    - "\uC0C1\uB300 \uCE74\uB4DC\uAC00 \uC798 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4\uBA74,
      **W**\xB7**D** \uD0A4\uB85C\n\uCE74\uBA54\uB77C \uC2DC\uC810\uC744 \uBC14\uAFC0
      \uC218 \uC788\uC73C\uB2C8 \uD65C\uC6A9\uD574\uBD10."
    - "\uC544\uBB34\uD2BC 21\uAE4C\uC9C4 \uC544\uC9C1 \uBAA8\uC790\uB77C\uB2C8\n\uD55C
      \uBC88 \uB354 **(\uD30C\uB791)\uD788\uD2B8**(\uC0C9 \uBE7C\uAE30)\uD574. (\uD788\uD2B8
      \uBC84\uD2BC \uD558\uC774\uB77C\uC774\uD2B8)"
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey:
    contractOptionId: 0
  - kind: 1
    lines: []
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 0
    lines:
    - "A \uCE74\uB4DC\uB77C, \uC6B4\uC774 \uC88B\uAD70."
    - "A \uCE74\uB4DC\uB294 1\uACFC 11 \uC911 21\uC5D0 \uAC00\uAE5D\uAC8C \uC790\uB3D9\uC73C\uB85C
      \uC124\uC815\uB418\uB294 \uCE74\uB4DC\uC9C0. \uB531 \uB9C8\uCE68 \uD569\uC774
      21\uC774 \uB410\uAD70."
    - "\uC55E\uC73C\uB85C \uC5B4\uB5A4 \uCE74\uB4DC\uAC00 \uB4E4\uC5B4\uC62C\uC9C0
      \uAD81\uAE08\uD558\uB2E4\uBA74 **\uB0B4 \uB371**\uC744 \uD074\uB9AD\uD574\uBD10.
      \uC5B4\uB5A4 \uCE74\uB4DC\uAC00 \uB0A8\uC544\uC788\uB294\uC9C0 \uC54C \uC218
      \uC788\uC744\uD14C\uB2C8. (\uB0B4 \uB371 \uD558\uC774\uB77C\uC774\uD2B8)"
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 1
    lines: []
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 6
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 0
    lines:
    - "\uAC8C\uC784 \uB3C4\uC911 **\uACF5\uAC1C \uCE74\uB4DC \uC22B\uC790\uC758 \uD569**\uC774
      21\uC774\n\uB118\uC73C\uBA74, **(\uBE68\uAC15)\uBC84\uC2A4\uD2B8**(\uC0C9 \uBE7C\uAE30)\uD55C\uB2E4.
      \uD328\uBC30\uD55C\uB2E4\uB294 \uB73B\uC774\uC9C0."
    - "\uB10C \uC774\uBBF8 \uC22B\uC790 \uCD1D\uD569\uC774 21\uC774 \uB418\uC5C8\uC73C\uB2C8\n\uCC28\uB840\uB97C
      \uB354 \uC9C4\uD589\uD560 \uD544\uC694\uB294 \uC5C6\uACA0\uAD70."
    - "**(\uC8FC\uD669)\uC2A4\uD0E0\uB4DC**(\uC0C9 \uBE7C\uAE30)\uB97C \uC120\uD0DD\uD558\uBA74
      \uC774\uBC88 \uB77C\uC6B4\uB4DC \uB0B4 \uCC28\uB840\uB97C \uC885\uB8CC\uD560
      \uC218 \uC788\uC5B4."
    - "\uB2E8, \uC0C1\uB300\uB294 \uD63C\uC790\uC11C \uACC4\uC18D \uCC28\uB840\uB97C
      \uC9C4\uD589\uD560 \uC218 \uC788\uAC8C \uB418\uB2C8\n**(\uC804\uCCB4 \uBCF4\uB77C)\uBC18\uB4DC\uC2DC
      \uBAA8\uB4E0 \uD589\uB3D9\uC744 \uB2E4 \uC9C4\uD589\uD588\uC744 \uB54C\uB9CC
      \uC120\uD0DD\uD558\uB3C4\uB85D.**"
    - "\uC774\uBC88\uC5D4 \uB354 \uC774\uC0C1 \uD560 \uC218 \uC788\uB294 \uAC8C \uC5C6\uC73C\uB2C8\n**(\uC8FC\uD669)\uC2A4\uD0E0\uB4DC**(\uC0C9
      \uBE7C\uAE30) \uD558\uC790\uACE0. (\uC2A4\uD0E0\uB4DC \uBC84\uD2BC \uD558\uC774\uB77C\uC774\uD2B8)"
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 1
    lines: []
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 1
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 0
    lines:
    - "\uD328\uC790\uB294 \uB300\uAC00\uB97C \uCE58\uB904\uC57C\uACA0\uC9C0."
    - "\uB77C\uC6B4\uB4DC\uC5D0\uC11C \uD328\uBC30\uD558\uBA74 **(\uBCF4\uB77C)\uC601\uD63C**
      1\uC744 \uC783\uAC8C \uB41C\uB2E4."
    - "\uB9CC\uC57D \uB450 \uC0AC\uB78C \uB2E4 21\uC744 \uB118\uAE30\uBA74,\n\uB458
      \uB2E4 \uD328\uBC30\uD55C\uB2E4."
    - "\uC601\uD63C\uC744 \uBAA8\uB450 \uC783\uC73C\uBA74 **(\uBE68\uAC15)\uC8FD\uB294\uB2E4.**
      \uB2F9\uC5F0\uD55C \uC77C\uC774\uC9C0."
    - "\uB458 \uB2E4 21\uC744 \uB118\uAE30\uC9C0 \uC54A\uC558\uB294\uB370 \uC22B\uC790
      \uCD1D\uD569\uC774 \uAC19\uC73C\uBA74\n\uC5B4\uB5BB\uAC8C \uB418\uB0D0\uACE0?
      \uD558, \uC65C \uC774\uB807\uAC8C \uCE90\uBB3C\uC5B4?"
    - "\uADF8\uB798, \uAE30\uBD84\uC774\uB2E4. \uADF8\uB7F0 \uACBD\uC6B0\uC5D0\uB294\n\uBB34\uC870\uAC74
      \uB124\uAC00 \uC774\uAE30\uB294 \uAC78\uB85C \uD574\uC904\uAC8C. \uB410\uB2C8?"
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 1
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 0
    lines:
    - "21\uAE4C\uC9C4 \uD55C\uCC38 \uBAA8\uC790\uB77C\uB294\uAD70. **(\uD30C\uB791)\uD788\uD2B8**(\uC0C9
      \uBE7C\uAE30)\uD574\uBCF4\uB77C\uACE0. (\uD788\uD2B8 \uBC84\uD2BC \uD558\uC774\uB77C\uC774\uD2B8)"
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 1
    lines: []
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 0
    lines:
    - "**\uB9AC\uBCFC\uBC84**\uAC00 \uB4E4\uC5B4\uC654\uAD70. \uAC00\uC838\uC628
      \uCD1D\uC740\n\uC0AC\uC6A9\uD574\uC8FC\uB294 \uAC8C \uB3C4\uB9AC\uACA0\uC9C0."
    - "\uCE74\uB4DC \uAC8C\uC784\uC5D0\uC11C \uBB34\uAE30\uB97C \uC4F0\uB294 \uAC8C
      \uC5B4\uB528\uB0D0\uACE0?\n\uC774\uBD10, \uC131\uC790\uB77C\uB3C4 \uC0C1\uB300\uD558\uACE0
      \uC788\uB294 \uC904 \uC54C\uC558\uC5B4?"
    - "5~10 \uCE74\uB4DC\uB4E4\uC740 \uB0B4 \uCC28\uB840\uC5D0 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uB294 \uCE74\uB4DC\uB4E4\uC774\uB2E4.\n\uACF5\uAC1C \uCE74\uB4DC\uB4E0,
      \uBE44\uACF5\uAC1C \uCE74\uB4DC\uB4E0 \uD074\uB9AD\uD558\uBA74 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC9C0."
    - "\uB2E4\uB9CC \uBE44\uACF5\uAC1C \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD558\uB824\uBA74
      **(\uC804\uCCB4 \uBE68\uAC15)\uBCF8\uC778 \uCE74\uB4DC\uB97C \uC0C1\uB300\uC5D0\uAC8C\n\uBCF4\uC5EC\uC918\uC57C
      \uD55C\uB2E4.**(\uC0C9 \uBE7C\uAE30) \uADF8 \uB9AC\uC2A4\uD06C\uB97C \uAC10\uC218\uD560
      \uC218 \uC788\uB2E4\uBA74 \uC0AC\uC6A9\uD574\uBD10."
    - "\uC0C1\uB300\uB294 \uBC14\uBCF4 \uAC19\uC774 \uBE44\uACF5\uAC1C \uCE74\uB4DC\uB97C
      \uC0AC\uC6A9\uD574\uBC84\uB838\uAD70.\n\uB9AC\uBCFC\uBC84\uB97C \uD074\uB9AD\uD574\uC11C
      \uC800 \uBA74\uC0C1\uC5D0 \uCD1D\uC54C\uC744 \uBC15\uC544\uBCF4\uC790\uACE0.
      (\uB9AC\uBCFC\uBC84 \uCE74\uB4DC \uD558\uC774\uB77C\uC774\uD2B8)"
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
    speaker: 0
    waitForBattleEndPresentation: 0
    gateKind: 0
    contractDefinitionKey: 
    contractOptionId: 0
  - kind: 1
    lines: []
    isIntro: 0
    delayBeforeSeconds: 0
    defersRoundTwoReveal: 0
