  demonLore:
  - definitionKey: satan
    loreDescription: "\uC885\uB9D0\uC758 \uBB38\uD131\uC5D0\uC11C \uD328\uBC30\uB77C\uB294
      \uB9D0\uC870\uCC28 \uAC70\uBD80\uD558\uB294 \uC9C0\uC625\uC758 \uC655. \uADF8\uC758
      \uACC4\uC57D\uC740 \uC2B9\uBD80\uAC00 \uB05D\uB0A0 \uC21C\uAC04\uC744 \uC5B5\uC9C0\uB85C
      \uB4A4\uB85C \uBBF8\uB8EC\uB2E4."
  - definitionKey: belphegor
    loreDescription: "\uBD88\uAE38\uD55C \uC608\uC9C0 \uC18D\uC5D0\uC11C \uAC00\uC7A5
      \uD3B8\uC548\uD55C \uAE38\uB9CC \uACE0\uB974\uB294 \uB098\uD0DC\uC758 \uC545\uB9C8.
      \uADF8\uB294 \uB2E4\uC74C \uD328\uB97C \uC5FF\uBCF4\uAC8C \uD558\uC9C0\uB9CC
      \uACB0\uB2E8\uC758 \uC790\uC720\uAE4C\uC9C0 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uB294\uB2E4."
  - definitionKey: mammon
    loreDescription: "\uBAA8\uB4E0 \uC6B4\uC744 \uAC12\uC73C\uB85C \uB9E4\uAE30\uB294
      \uD0D0\uC695\uC758 \uC545\uB9C8. \uC8FC\uC0AC\uC704\uAC00 \uC57D\uC18D\uD55C
      \uC774\uB4DD\uC740 \uC5B8\uC81C\uB098 \uD30C\uBA78\uC758 \uC22B\uC790\uC640
      \uB9DE\uB2FF\uC544 \uC788\uB2E4."
  - definitionKey: leviathan
    loreDescription: "\uC2E4\uD328\uD55C \uC608\uCE21\uB9C8\uC800 \uC9D1\uC694\uD558\uAC8C
      \uC0BC\uD0A4\uB294 \uC2EC\uC5F0\uC758 \uC545\uB9C8. \uB450 \uBC88\uC9F8 \uAE30\uD68C
      \uB4A4\uC5D0\uB294 \uBC18\uB4DC\uC2DC \uB300\uAC00\uAC00 \uB0A8\uB294\uB2E4."
  - definitionKey: beelzebub
    loreDescription: "\uC369\uC740 \uC2B9\uBD80 \uC704\uC5D0 \uAD70\uB9BC\uD558\uB294
      \uD30C\uB9AC\uC758 \uAD70\uC8FC. \uD328\uBC30\uC758 \uC21C\uAC04\uC870\uCC28
      \uC81C\uBB3C\uB85C \uBC14\uAFB8\uC5B4 \uB2E4\uC2DC \uD310\uC744 \uC774\uC5B4
      \uAC04\uB2E4."
  - definitionKey: mephistopheles
    loreDescription: "\uD55C\uB9C8\uB514 \uC18D \uAC70\uC9D3\uC744 \uCE7C\uB0A0\uCC98\uB7FC
      \uBCBC\uB9AC\uB294 \uACC4\uC57D\uC790. \uC9C4\uC2E4\uC774 \uB4DC\uB7EC\uB0A0\uC218\uB85D
      \uADF8\uC758 \uAC70\uB798\uB294 \uB354 \uC794\uD639\uD574\uC9C4\uB2E4."
  - definitionKey: asmodeus
    loreDescription: "\uC695\uB9DD\uACFC \uC870\uAE09\uD568\uC744 \uBD80\uCD94\uAE30\uB294
      \uC545\uB9C8. \uC0C1\uB300\uAC00 \uBA48\uCD94\uAE30 \uC804\uC5D0 \uD55C \uC7A5
      \uB354 \uC190\uC744 \uBED7\uAC8C \uB9CC\uB4E0\uB2E4."
  - definitionKey: azazel
    loreDescription: "\uC774\uBBF8 \uB05D\uB09C \uB3C4\uAD6C\uC5D0 \uB2E4\uC2DC \uBD88\uC744
      \uBD99\uC774\uB294 \uD0C0\uB77D\uD55C \uC7A5\uC778. \uB418\uC0B4\uB9B0 \uD798\uC740
      \uAC19\uC740 \uC22B\uC790\uC758 \uC800\uC8FC\uB97C \uBD88\uB7EC\uC628\uB2E4."
  - definitionKey: paimon
    loreDescription: "\uC2B9\uB9AC \uB4A4 \uB0A8\uC740 \uAC00\uB2A5\uC131\uAE4C\uC9C0
      \uAC70\uB450\uB294 \uC9C0\uC625\uC758 \uAD70\uC8FC. \uADF8\uC758 \uBA85\uB839\uC744
      \uBC1B\uC740 \uCE74\uB4DC\uB294 \uD55C\uB3D9\uC548 \uB371\uC5D0\uC11C \uC790\uCDE8\uB97C
      \uAC10\uCD98\uB2E4."
  - definitionKey: belial
    loreDescription: "\uBC95\uACFC \uC18C\uC720\uB97C \uBE44\uC6C3\uB294 \uBB34\uBC95\uC758
      \uC545\uB9C8. \uC0C1\uB300\uC758 \uD798\uC744 \uBE7C\uC557\uC544 \uC8FC\uC778\uC758
      \uC190\uC5D0\uC11C \uB2E4\uC2DC \uC4F0\uAC8C \uD55C\uB2E4."
  - definitionKey: baphomet
    loreDescription: "\uC11C\uB85C\uC758 \uB371\uC5D0 \uAC19\uC740 \uC800\uC8FC\uB97C
      \uC0C8\uAE30\uB294 \uAC80\uC740 \uC758\uC2DD\uC758 \uC8FC\uC778. \uBA3C\uC800
      \uD45C\uC2DD\uC744 \uC18C\uC9C4\uD55C \uC790\uAC00 \uC81C\uBB3C\uC774 \uB41C\uB2E4."
  - definitionKey: lucifer
    loreDescription: "\uAC00\uC7A5 \uBE5B\uB098\uB294 \uC57D\uC18D\uC73C\uB85C \uB354
      \uAE4A\uC740 \uACC4\uC57D\uC744 \uAD8C\uD558\uB294 \uD0C0\uB77D\uD55C \uBCC4.
      \uADF8\uC758 \uC190\uC744 \uC7A1\uC73C\uBA74 \uB610 \uB2E4\uB978 \uC545\uB9C8\uC758
      \uBB38\uC774 \uC5F4\uB9B0\uB2E4."
