%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a25b412ec1f43b984b88598293940c2, type: 3}
  m_Name: final_boss_speech
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.SpeechProfileSO
  speakerKey: final-boss
  entries:
  - cueKey: combat.battle_start
    lines:
    - "\uCD5C\uD6C4\uC758 \uC2B9\uBD80\uC5D0 \uC628 \uAC78 \uD658\uC601\uD55C\uB2E4."
    - "\uC790, \uC5EC\uAE30\uC11C \uB05D\uB0B4 \uC8FC\uB9C8."
  - cueKey: combat.round_start
    lines:
    - "\uB2E4\uC2DC \uC2DC\uC791\uD558\uC9C0."
    - "\uC0C8 \uB77C\uC6B4\uB4DC\uB2E4."
  - cueKey: combat.action.hit
    lines:
    - "\uD788\uD2B8."
    - "\uD55C \uC7A5 \uB354."
  - cueKey: combat.action.stand
    lines:
    - "\uC2A4\uD0E0\uB4DC."
    - "\uC774\uAC78\uB85C \uCDA9\uBD84\uD558\uACA0\uAD70."
  - cueKey: combat.action.change
    lines:
    - "\uCCB4\uC778\uC9C0."
    - "\uB354 \uB098\uC740 \uD328\uAC00 \uD544\uC694\uD558\uACA0\uAD70."
  - cueKey: combat.action.use_card
    lines:
    - "\uC774\uAC78 \uC0AC\uC6A9\uD558\uACA0\uB2E4."
    - "\uC774\uAC8C \uC88B\uACA0\uAD70."
  - cueKey: combat.action.demon_contract
    lines:
    - "\uC545\uB9C8\uC870\uCC28 \uB098\uB97C \uAC70\uC2A4\uB97C \uC218\uB294 \uC5C6\uB2E4..."
    - "\uACC4\uC57D\uD558\uACA0\uB2E4. \uC774\uBC88\uC5D4 \uC774\uAC78\uB85C."
  - cueKey: combat.damage.card
    lines:
    - "\uBB34\uC758\uBBF8\uD55C \uC9D3\uC77C \uBFD0\uC774\uB2E4...!"
    - "\uADF8 \uBCF4\uC798\uAC83\uC5C6\uB294 \uC218\uB97C \uAE30\uC5B5\uD558\uB9C8."
  - cueKey: combat.damage.round
    lines:
    - "\uC560\uC1A1\uC774\uAC00...!"
    - "\uC6B0\uCB50\uB300\uC9C0 \uB9C8\uB77C. \uB2E4\uC74C\uC740 \uC5C6\uB2E4."
  - cueKey: combat.damage.other
    lines:
    - "\uC774\uB984 \uC5C6\uB294 \uD798\uC774 \uAC10\uD788 \uB2FF\uB294\uAD6C\uB098."
    - "\uAE30\uBB18\uD55C \uC7AC\uC8FC\uB85C \uC655\uC744 \uC2DC\uD5D8\uD558\uB294\uAC00."
  - cueKey: combat.low_soul
    lines:
    - "\uC544\uC9C1\uC774\uB2E4..."
    - "\uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uB2E4...!"
  - cueKey: combat.victory
    lines:
    - "\uBB34\uB98E \uAFC7\uC5B4\uB77C, \uD328\uC790\uB294 \uB9D0\uC774 \uC5C6\uB2E4."
    - "\uC5ED\uC2DC \uC794\uCC59\uC774\uC600\uAD70."
  - cueKey: combat.defeat
    lines:
    - "\uB0B4\uAC00 \uD328\uBC30\uD558\uB2E4\uB2C8...!"
    - "\uB124\uAC00 \uC774\uACBC\uB2E4..."
  - cueKey: combat.action.revolver.before
    lines:
    - "왕의 총구 앞에 고개를 숙여라."
  - cueKey: combat.action.revolver.hit
    lines:
    - "왕의 탄환은 빗나가지 않는다."
  - cueKey: combat.action.revolver.miss
    lines:
    - "한 번의 자비라 여겨라."
  - cueKey: combat.action.knife.before
    lines:
    - "친히 네 운명을 베어 주마."
  - cueKey: combat.action.knife.bust
    lines:
    - "보잘것없는 그릇이 깨졌구나."
  - cueKey: combat.action.knife.no_bust
    lines:
    - "아직 왕 앞에 설 힘은 남았나."
  - cueKey: combat.action.hammer.before
    lines:
    - "왕에게 불필요한 패는 존재하지 않는다."
  - cueKey: combat.action.hammer.bust
    lines:
    - "이것이 왕의 판결이다."
  - cueKey: combat.action.hammer.no_bust
    lines:
    - "겨우 한 번의 판결을 견뎠군."
  - cueKey: combat.action.demon_contract.belphegor
    lines:
    - "벨페고르여, 왕의 앞길을 미리 밝히라."
  - cueKey: combat.action.demon_contract.beelzebub
    lines:
    - "바알제붑이 왕의 죽음을 거부한다."
  - cueKey: combat.action.demon_contract.mammon
    lines:
    - "마몬이여, 운명마저 내게 바쳐라."
  - cueKey: combat.action.demon_contract.asmodeus
    lines:
    - "아스모데우스여, 저자를 복종시켜라."
  - cueKey: combat.action.demon_contract.satan
    lines:
    - "사탄의 권능조차 왕의 명에 따른다."
  - cueKey: combat.action.demon_contract.azazel
    lines:
    - "아자젤이여, 왕의 패에 두 번 답하라."
  - cueKey: combat.reaction.player.manual_card
    lines:
    - "그 장난감으로 왕을 시험하는가."
  - cueKey: combat.reaction.player.demon_contract
    lines:
    - "감히 왕의 신하를 부리는구나."
  - cueKey: combat.reaction.player.automatic_card
    lines:
    - "하찮은 카드가 스스로 발악하는군."
