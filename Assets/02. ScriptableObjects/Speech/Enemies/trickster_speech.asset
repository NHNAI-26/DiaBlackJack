%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a25b412ec1f43b984b88598293940c2, type: 3}
  m_Name: trickster_speech
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.SpeechProfileSO
  speakerKey: trickster
  entries:
  - cueKey: combat.battle_start
    lines:
    - "\uC790, \uC1FC\uD0C0\uC784!"
    - "\uC815\uC815\uB2F9\uB2F9\uD55C \uC2B9\uBD80\uC57C, \uC544\uB9C8\uB3C4."
  - cueKey: combat.round_start
    lines:
    - "\uB610 \uD55C \uD310 \uB180\uC544 \uBCF4\uC790\uACE0!"
    - "\uC0C8\uB85C\uC6B4 \uC1FC\uAC00 \uC2DC\uC791\uB418\uB294\uAD70!"
  - cueKey: combat.action.hit
    lines:
    - "\uD55C \uC7A5 \uB354 \uBCF4\uC790\uACE0!"
    - "\uC774\uBC88\uC5D4 \uBB34\uC2A8 \uCE74\uB4DC\uC77C\uAE4C?"
  - cueKey: combat.action.stand
    lines:
    - "\uB09C \uC5EC\uAE30\uAE4C\uC9C0!"
    - "\uC774 \uC815\uB3C4\uBA74 \uC774\uAE34 \uAC83 \uAC19\uAD6C\uB9CC."
  - cueKey: combat.action.change
    lines:
    - "\uC2AC\uCA4D... \uC7A0\uAE50, \uBCF8 \uAC70 \uC544\uB2C8\uC9C0?!"
    - "\uD328 \uC880 \uBC14\uAFC0\uAC8C. \uBD88\uB9CC \uC788\uC73C\uBA74 \uB108\uB3C4
      \uD558\uB4E0\uAC00!"
  - cueKey: combat.action.use_card
    lines:
    - "\uC774\uAC74 \uC774\uB807\uAC8C \uC4F0\uB294 \uAC70\uC57C!"
    - "\uC790, \uC798 \uBCF4\uB77C\uACE0!"
  - cueKey: combat.action.demon_contract
    lines:
    - "\uC545\uB9C8\uB3C4 \uB0B4 \uC7A5\uB09C\uAC10\uC774\uC9C0!"
    - "\uACC4\uC57D\uC11C\uC5D0 \uB099\uC11C \uC880 \uD588\uC5B4."
  - cueKey: combat.damage.card
    lines:
    - "\uBC18\uCE59!!! \uBC18\uCE59\uC774\uC57C!!!"
    - "\uB07C\uC694\uC624\uC624\uC624\uC637!!!!"
  - cueKey: combat.damage.round
    lines:
    - "\uC7A0\uAE50, \uC0AC\uAE30 \uCE5C \uAC70 \uC544\uB2C8\uC57C?"
    - "\uC7AC\uBBF8\uC5C6\uAD70."
  - cueKey: combat.damage.other
    lines:
    - "\uADF8\uAC74 \uADDC\uCE59\uCC45\uC5D0\uB3C4 \uC5C6\uC5C8\uB294\uB370!"
    - "\uBC18\uCE59 \uAC19\uC740\uB370 \uBA4B\uC9C0\uAE34 \uD558\uB124."
  - cueKey: combat.low_soul
    lines:
    - "\uC7A0\uAE50, \uAC70\uC9D3\uB9D0\uC774\uC9C0? \uBC8C\uC368 \uB9C8\uC9C0\uB9C9\uC774\uB77C\uACE0?"
    - "\uADF8\uB9CC, \uADF8\uB9CC! \uB098 \uC815\uB9D0 \uC8FD\uB294\uB2E4\uACE0?!"
  - cueKey: combat.victory
    lines:
    - "\uBB50\uC57C, \uADF8 \uC5BC\uBE60\uC9C4 \uD45C\uC815\uC740? \uC369 \uAEBC\uC9C0\uB77C\uACE0!"
    - "\uC5F0\uC2B5 \uC0C1\uB300\uC870\uCC28 \uC548 \uB418\uB294\uAD70."
  - cueKey: combat.defeat
    lines:
    - "\uB9D0\uB3C4 \uC548 \uB3FC! \uB0B4\uAC00 \uC9C8 \uB9AC\uAC00 \uC5C6\uB2E4\uACE0!!"
    - "\uC778\uC815 \uBABB \uD574... \uC778\uC815 \uBABB \uD55C\uB2E4\uACE0...!!"
  - cueKey: combat.action.revolver.before
    lines:
    - "자, 오늘의 묘기는 단 한 발!"
  - cueKey: combat.action.revolver.hit
    lines:
    - "정중앙! 박수는 크게 부탁해!"
  - cueKey: combat.action.revolver.miss
    lines:
    - "빗나감까지 계산된 연출이지!"
  - cueKey: combat.action.hammer.before
    lines:
    - "이번 순서는 카드 분쇄 마술이야!"
  - cueKey: combat.action.hammer.bust
    lines:
    - "짜잔, 관객 한 명이 사라졌습니다!"
  - cueKey: combat.action.hammer.no_bust
    lines:
    - "아직 피날레가 남았다고!"
  - cueKey: combat.action.automatic.lie-detector-3
    lines:
    - "거짓말은 쇼의 재미를 망치지!"
  - cueKey: combat.reaction.player.manual_card
    lines:
    - "오, 제법 볼 만한 묘기인데?"
  - cueKey: combat.reaction.player.demon_contract
    lines:
    - "악마까지 특별 출연이라니 화려하군!"
  - cueKey: combat.reaction.player.automatic_card
    lines:
    - "소품이 혼자 움직이다니 훌륭해!"
