--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a25b412ec1f43b984b88598293940c2, type: 3}
  m_Name: cultist_speech
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.SpeechProfileSO
  speakerKey: cultist
  entries:
  - cueKey: combat.battle_start
    lines:
    - "\uC131\uD654\uAC00 \uB124 \uC601\uD63C\uC744 \uBD80\uB978\uB2E4."
    - "\uC608\uC5B8\uC758 \uC790\uB9AC\uC5D0 \uC798 \uC654\uAD6C\uB098."
  - cueKey: combat.round_start
    lines:
    - "\uC0C8 \uACC4\uC2DC\uAC00 \uB0B4\uB824\uC628\uB2E4."
    - "\uD53C\uC758 \uACBD\uC804\uC774 \uB2E4\uC2DC \uD3BC\uCCD0\uC9C4\uB2E4."
  - cueKey: combat.action.hit
    lines:
    - "\uACC4\uC2DC\uB97C \uD55C \uC7A5 \uB354."
    - "\uC2EC\uC5F0\uC758 \uB73B\uC744 \uB354 \uBCF4\uB9AC\uB77C."
  - cueKey: combat.action.stand
    lines:
    - "\uB73B\uC740 \uC774\uBBF8 \uC644\uC131\uB418\uC5C8\uB2E4."
    - "\uC5EC\uAE30\uC11C \uAE30\uB3C4\uB97C \uBA48\uCD94\uB178\uB77C."
  - cueKey: combat.action.change
    lines:
    - "\uBD88\uACBD\uD55C \uD328\uB97C \uC53B\uC5B4\uB0B4\uB9AC\uB77C."
    - "\uACC4\uC2DC\uC5D0 \uB9DE\uB294 \uD328\uB85C \uBC14\uAFB8\uB9AC\uB77C."
  - cueKey: combat.action.use_card
    lines:
    - "\uC131\uBB3C\uC758 \uD798\uC744 \uBCF4\uC544\uB77C."
    - "\uBD09\uC778\uB41C \uC740\uCD1D\uC744 \uD47C\uB2E4."
  - cueKey: combat.action.demon_contract
    lines:
    - "\uACC4\uC57D\uC790\uC5EC, \uC751\uB2F5\uD558\uB77C."
    - "\uC5B4\uB460\uC758 \uC11C\uC57D\uC744 \uC9D1\uD589\uD558\uB178\uB77C."
  - cueKey: combat.damage.card
    lines:
    - "\uAC70\uC9D3 \uC131\uBB3C\uC774 \uC0B4\uC744 \uBCA0\uB294\uAD6C\uB098."
    - "\uB124 \uCE74\uB4DC\uC5D0\uB3C4 \uD53C\uC758 \uCD95\uBCF5\uC774 \uC788\uAD70."
  - cueKey: combat.damage.round
    lines:
    - "\uC18D\uC138\uC758 \uC218\uAC00 \uB098\uB97C \uAEBE\uB294\uAC00."
    - "\uC22B\uC790\uC758 \uC2EC\uD310\uC774 \uB0B4\uB824\uC654\uAD70."
  - cueKey: combat.damage.other
    lines:
    - "\uC774 \uACE0\uD1B5\uB9C8\uC800 \uACC4\uC2DC\uB2E4."
    - "\uC54C \uC218 \uC5C6\uB294 \uB73B\uC774 \uBAB8\uC744 \uAC00\uB978\uB2E4."
  - cueKey: combat.low_soul
    lines:
    - "\uC721\uC2E0\uC740 \uC57D\uD574\uB3C4 \uBBFF\uC74C\uC740 \uB0A8\uB294\uB2E4."
    - "\uD53C\uAC00 \uB9C8\uB97C\uC218\uB85D \uC2E0\uC740 \uAC00\uAE4C\uC6CC\uC9C4\uB2E4."
  - cueKey: combat.victory
    lines:
    - "\uB124 \uC601\uD63C\uC774 \uC81C\uB2E8\uC5D0 \uC62C\uB790\uB2E4."
    - "\uC608\uC5B8\uC740 \uD55C \uCE58\uB3C4 \uBE57\uB098\uAC00\uC9C0 \uC54A\uC558\uB2E4."
  - cueKey: combat.defeat
    lines:
    - "\uAD50\uB2E8\uC740 \uB0B4 \uC8FD\uC74C\uB3C4 \uAE30\uC5B5\uD558\uB9AC\uB77C."
    - "\uC624\uB298\uC758 \uC774\uB2E8\uC740 \uB124\uAC00 \uB418\uC5C8\uAD6C\uB098."
