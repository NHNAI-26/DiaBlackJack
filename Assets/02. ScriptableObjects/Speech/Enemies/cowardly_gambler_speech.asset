%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a25b412ec1f43b984b88598293940c2, type: 3}
  m_Name: cowardly_gambler_speech
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.SpeechProfileSO
  speakerKey: cowardly-gambler
  entries:
  - cueKey: combat.battle_start
    lines:
    - "\uC7A0\uAE50, \uADF8\uB0E5 \uC5F0\uC2B5 \uD310\uC774\uC9C0?"
    - "\uB098, \uB0A0 \uB0B4\uBCF4\uB0B4 \uC918!!"
  - cueKey: combat.round_start
    lines:
    - "\uB610 \uD55C\uB2E4\uACE0? \uC9D1\uC5D0 \uAC00\uACE0 \uC2F6\uC740\uB370..."
    - "\uB05D\uB09C \uAC70 \uC544\uB2C8\uC57C?"
  - cueKey: combat.action.hit
    lines:
    - "\uD55C \uC7A5\uB9CC \uB354 \uBCF4\uBA74 \uB420 \uAC83 \uAC19\uC544."
    - "\uC774\uBC88\uC5D4 \uC9C4\uC9DC \uC88B\uC740 \uD328\uAC00 \uC62C \uAC70\uC57C."
  - cueKey: combat.action.stand
    lines:
    - "\uBA48\uCD9C\uAC8C, \uB354 \uD558\uBA74 \uB9DD\uD560 \uAC83 \uAC19\uC544."
    - "\uC774\uCBE4\uC774\uBA74 \uC548\uC804\uD558\uC9C0? \uADF8\uB807\uC9C0?"
  - cueKey: combat.action.change
    lines:
    - "\uC774 \uD328 \uD0D3\uC774\uC57C, \uBC14\uAFD4 \uC918."
    - "\uB2E4, \uB2E4\uB978 \uAC78\uB85C \uBC14\uAFC0\uB798."
  - cueKey: combat.action.use_card
    lines:
    - "\uC774\uAC74 \uBC18\uCE59 \uC544\uB2C8\uC9C0? \uC0B4\uB824\uACE0 \uC4F0\uB294
      \uAC70\uC57C."
    - "\uBBF8\uC548, \uB0B4\uAC00 \uC0B4\uAE30 \uC704\uD574\uC11C\uC57C!!"
  - cueKey: combat.action.demon_contract
    lines:
    - "\uACC4\uC57D\uC740 \uC545\uB9C8\uAC00 \uBA3C\uC800 \uAD8C\uD55C \uAC70\uC57C."
    - "\uB09C \uC11C\uBA85\uB9CC \uD588\uC5B4, \uC815\uB9D0\uC774\uC57C."
  - cueKey: combat.damage.card
    lines:
    - "\uB044\uC544\uC544\uC544\uC544\uC545!!"
    - "\uC81C, \uC81C\uBC1C \uC0B4\uB824 \uC918!!"
  - cueKey: combat.damage.round
    lines:
    - "\uB0B4\uAC00 \uC84C\uB2E4\uACE0? \uC798\uBABB \uC13C \uAC70 \uC544\uB2C8\uC57C?"
    - "\uADF8\uB0E5 \uC6B4\uC774 \uC548 \uC88B\uC558\uC744 \uBFD0\uC774\uB77C\uACE0!"
  - cueKey: combat.damage.other
    lines:
    - "\uC774\uAC74 \uB0B4\uAC00 \uB4E4\uC740 \uADDC\uCE59\uC774 \uC544\uB2C8\uC57C!"
    - "\uC65C \uC774\uC0C1\uD55C \uB370\uC11C \uC544\uD508 \uAC74\uB370?"
  - cueKey: combat.low_soul
    lines:
    - "\uC774\uC81C \uC9C4\uC9DC \uD55C\uACC4\uC57C...!"
    - "\uC81C\uBC1C \uADF8\uB9CC \uAD34\uB86D\uD600 \uC918..."
  - cueKey: combat.victory
    lines:
    - "\uC0B4\uC558\uB2E4! \uC804\uBD80 \uB0B4 \uC2E4\uB825\uC774\uC57C."
    - "\uC774, \uC774\uC81C \uC9D1\uC5D0 \uBCF4\uB0B4 \uC8FC\uB294 \uAC70\uC57C...?"
  - cueKey: combat.defeat
    lines:
    - "\uB9D0\uB3C4 \uC548 \uB3FC..."
    - "\uC774\uAC74 \uAFC8\uC77C \uAC70\uC57C..."
