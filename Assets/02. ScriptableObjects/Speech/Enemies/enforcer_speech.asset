%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a25b412ec1f43b984b88598293940c2, type: 3}
  m_Name: enforcer_speech
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.SpeechProfileSO
  speakerKey: enforcer
  entries:
  - cueKey: combat.battle_start
    lines:
    - "\uC9D1\uD589 \uC808\uCC28\uB97C \uAC1C\uC2DC\uD55C\uB2E4."
    - "\uB124 \uC8D7\uAC12\uC744 \uCE58\uB97C \uC2DC\uAC04\uC774\uB2E4."
  - cueKey: combat.round_start
    lines:
    - "\uB124 \uC8FD\uC74C\uC774 \uAC00\uAE4C\uC6CC\uC9C4\uB2E4."
    - "\uB9C8\uC154\uB77C. \uB124 \uC6B4\uBA85\uC774\uB2E4."
  - cueKey: combat.action.hit
    lines:
    - "\uD55C \uC7A5 \uB354."
    - "\uC544\uC9C1 \uB05D\uB0BC \uB54C\uAC00 \uC544\uB2C8\uAD70."
  - cueKey: combat.action.stand
    lines:
    - "\uC774 \uC815\uB3C4\uBA74 \uCDA9\uBD84\uD558\uB2E4."
    - "\uC5EC\uAE30\uAE4C\uC9C0\uB2E4."
  - cueKey: combat.action.change
    lines:
    - "\uD328\uB97C \uAD50\uCCB4\uD55C\uB2E4."
    - "\uB2E4\uB978 \uD328\uB85C \uC9D1\uD589\uD558\uACA0\uB2E4."
  - cueKey: combat.action.use_card
    lines:
    - "\uB3C4\uAD6C\uB97C \uC4F8 \uB54C\uAD70."
    - "\uC774\uAC78\uB85C \uB05D\uB0B4 \uC8FC\uB9C8."
  - cueKey: combat.action.demon_contract
    lines:
    - "\uC545\uB9C8\uB3C4 \uC9D1\uD589\uC744 \uD53C\uD560 \uC21C \uC5C6\uB2E4."
    - "\uACC4\uC57D\uC758 \uD798\uC744 \uBE4C\uB9AC\uACA0\uB2E4."
  - cueKey: combat.damage.card
    lines:
    - "\uC544\uD504\uAD70."
    - "\uADF8 \uC218... \uAE30\uC5B5\uD558\uACA0\uB2E4."
  - cueKey: combat.damage.round
    lines:
    - "\uD615\uC774 \uC7A0\uC2DC \uBBF8\uB904\uC84C\uC744 \uBFD0\uC774\uB2E4."
    - "\uB124\uAC00 \uC774\uACBC\uB2E4. \uC774\uBC88\uC5D4."
  - cueKey: combat.damage.other
    lines:
    - "\uBBF8\uBD84\uB958 \uD53C\uD574\uAC00 \uBC1C\uC0DD\uD588\uB2E4."
    - "\uC608\uC678 \uC190\uC0C1\uC744 \uAE30\uB85D\uD55C\uB2E4."
  - cueKey: combat.low_soul
    lines:
    - "\uC544\uC9C1 \uC4F0\uB7EC\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
    - "\uC774 \uC815\uB3C4\uB85C \uC9D1\uD589\uC744 \uBA48\uCD94\uC9C0\uB294 \uC54A\uB294\uB2E4..."
  - cueKey: combat.victory
    lines:
    - "\uD615\uC744 \uC9D1\uD589\uD588\uB2E4."
    - "\uB05D\uC774\uB2E4. \uB354\uB294 \uC800\uD56D\uD558\uC9C0 \uB9C8\uB77C."
  - cueKey: combat.defeat
    lines:
    - "\uC0B4\uC544\uB0A8\uC558\uAD70. \uCD95\uD558\uD55C\uB2E4."
    - "\uC774\uBC88 \uD310\uACB0\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4. \uAC00\uB77C."
  - cueKey: combat.action.revolver.before
    lines:
    - "사격 집행을 개시한다."
  - cueKey: combat.action.revolver.hit
    lines:
    - "명중을 확인했다."
  - cueKey: combat.action.revolver.miss
    lines:
    - "오차를 기록한다."
  - cueKey: combat.action.knife.before
    lines:
    - "근접 집행 절차로 전환한다."
  - cueKey: combat.action.knife.bust
    lines:
    - "대상의 파열을 확인했다."
  - cueKey: combat.action.knife.no_bust
    lines:
    - "대상 생존, 집행을 계속한다."
  - cueKey: combat.action.hammer.before
    lines:
    - "불필요한 증거를 파기한다."
  - cueKey: combat.action.hammer.bust
    lines:
    - "파기와 함께 형이 확정됐다."
  - cueKey: combat.action.hammer.no_bust
    lines:
    - "파기 완료, 다음 절차로 간다."
  - cueKey: combat.action.automatic.poison-1
    lines:
    - "독극물 투입 절차를 실행한다."
  - cueKey: combat.action.automatic.lie-detector-3
    lines:
    - "진술의 진위를 검사한다."
  - cueKey: combat.action.automatic.flamethrower-4
    lines:
    - "소각 대상으로 판정했다."
  - cueKey: combat.action.automatic.pocket-watch-5
    lines:
    - "사용 완료 도구를 재가동한다."
  - cueKey: combat.reaction.player.manual_card
    lines:
    - "도구 사용을 확인했다."
  - cueKey: combat.reaction.player.demon_contract
    lines:
    - "불법 계약 행위를 기록한다."
  - cueKey: combat.reaction.player.automatic_card
    lines:
    - "자동 장치의 작동을 확인했다."
