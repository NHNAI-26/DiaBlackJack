--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a25b412ec1f43b984b88598293940c2, type: 3}
  m_Name: enforcer_speech
  m_EditorClassIdentifier: Border::DiaBlackJack.Content.SpeechProfileSO
  speakerKey: enforcer
  entries:
  - cueKey: combat.battle_start
    lines:
    - "\uC9D1\uD589 \uC808\uCC28\uB97C \uAC1C\uC2DC\uD55C\uB2E4."
    - "\uB300\uC0C1 \uD655\uC778. \uCC98\uBD84\uC744 \uC2DC\uC791\uD55C\uB2E4."
  - cueKey: combat.round_start
    lines:
    - "\uB2E4\uC74C \uC808\uCC28\uB85C \uC774\uD589\uD55C\uB2E4."
    - "\uC0C8 \uB77C\uC6B4\uB4DC. \uAE30\uB85D\uC744 \uAC31\uC2E0\uD55C\uB2E4."
  - cueKey: combat.action.hit
    lines:
    - "\uCD94\uAC00 \uCE74\uB4DC\uB97C \uC694\uCCAD\uD55C\uB2E4."
    - "\uD55C \uC7A5 \uBCF4\uCDA9\uD55C\uB2E4."
  - cueKey: combat.action.stand
    lines:
    - "\uD604\uC7AC \uD328\uB97C \uD655\uC815\uD55C\uB2E4."
    - "\uCD94\uAC00 \uD589\uB3D9\uC744 \uC911\uB2E8\uD55C\uB2E4."
  - cueKey: combat.action.change
    lines:
    - "\uBD88\uB7C9 \uD328\uB97C \uAD50\uCCB4\uD55C\uB2E4."
    - "\uCE74\uB4DC \uAD50\uD658\uC744 \uC9D1\uD589\uD55C\uB2E4."
  - cueKey: combat.action.use_card
    lines:
    - "\uC7A5\uBE44 \uC0AC\uC6A9\uC744 \uC2B9\uC778\uD55C\uB2E4."
    - "\uB3C4\uAD6C\uB97C \uD22C\uC785\uD55C\uB2E4."
  - cueKey: combat.action.demon_contract
    lines:
    - "\uACC4\uC57D \uC870\uD56D\uC744 \uC2E4\uD589\uD55C\uB2E4."
    - "\uC545\uB9C8 \uC790\uC0B0\uC744 \uD638\uCD9C\uD55C\uB2E4."
  - cueKey: combat.damage.card
    lines:
    - "\uCE74\uB4DC \uACF5\uACA9 \uD53C\uD574\uB97C \uD655\uC778\uD588\uB2E4."
    - "\uC7A5\uBE44\uC131 \uC190\uC0C1\uC73C\uB85C \uAE30\uB85D\uD55C\uB2E4."
  - cueKey: combat.damage.round
    lines:
    - "\uD310\uC815 \uD53C\uD574\uB97C \uBC18\uC601\uD55C\uB2E4."
    - "\uC218\uCE58 \uBE44\uAD50 \uACB0\uACFC\uB97C \uC218\uC6A9\uD55C\uB2E4."
  - cueKey: combat.damage.other
    lines:
    - "\uBBF8\uBD84\uB958 \uD53C\uD574\uAC00 \uBC1C\uC0DD\uD588\uB2E4."
    - "\uC608\uC678 \uC190\uC0C1\uC744 \uAE30\uB85D\uD55C\uB2E4."
  - cueKey: combat.low_soul
    lines:
    - "\uC794\uC5EC \uC601\uD63C\uC774 \uC784\uACC4\uCE58 \uC774\uD558\uB2E4."
    - "\uC0C1\uD0DC \uC704\uD5D8. \uC784\uBB34\uB294 \uACC4\uC18D\uD55C\uB2E4."
  - cueKey: combat.victory
    lines:
    - "\uB300\uC0C1 \uCC98\uBD84\uC744 \uC644\uB8CC\uD588\uB2E4."
    - "\uC9D1\uD589 \uC885\uB8CC. \uC800\uD56D \uC5C6\uC74C."
  - cueKey: combat.defeat
    lines:
    - "\uC9D1\uD589 \uC2E4\uD328\uB97C \uBCF4\uACE0\uD55C\uB2E4."
    - "\uAE30\uB2A5 \uC815\uC9C0. \uC784\uBB34\uB97C \uC885\uB8CC\uD55C\uB2E4."
